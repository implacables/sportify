# Benchmark outputs (manifests and schemas are tracked)
sportify-game-reconstruction/benchmarks/results/*
!sportify-game-reconstruction/benchmarks/results/.gitkeep
!sportify-game-reconstruction/benchmarks/results/README.md

# External benchmark dependencies
sportify-game-reconstruction/benchmarks/vendor/

# Datasets, model weights, large media
data/
*.pkl
*.pklz
*.pt
*.pth
*.onnx
*.mp4
*.mkv
*.avi
*.mov

# Experiment inputs (images stay local; track empty dirs via .gitkeep)
sportify-game-reconstruction/experiments/easyocr/images/**
!sportify-game-reconstruction/experiments/easyocr/images/**/
!sportify-game-reconstruction/experiments/easyocr/images/**/.gitkeep

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
dist/
build/

# Environment and secrets
.env
.env.*
!.env.example
scripts/sportify-env.local.sh

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Scoring system: local-only research artifacts
# _research-notes/ is local scratch (consolidated into sportify-scoring/docs/research/)
_research-notes/
# Paper PDFs kept local for now (see sportify-scoring/docs/research/papers/README.md for links)
sportify-scoring/docs/research/papers/*.pdf

# Generated documents (regenerate from .md with pandoc)
*.docx
